<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="WhackAMole.MainPage"
             BackgroundColor="{StaticResource PageBackground}">

    <ScrollView>
        <VerticalStackLayout Padding="30,0" Spacing="25">

            <Label Text="WHACK-A-MOLE" Style="{StaticResource TitleLabel}"/>

            <HorizontalStackLayout HorizontalOptions="Center" Spacing="40">
                <Label x:Name="ScoreLabel" Text="Score: 0" Style="{StaticResource StatLabel}" />
                <Label x:Name="TimeLabel" Text="Time: 30" Style="{StaticResource StatLabel}" />
            </HorizontalStackLayout>

            <Grid x:Name="GameGrid" HeightRequest="300" WidthRequest="300">
                <Border x:Name="Mole" 
                        ZIndex="1"
                        Opacity="0"
                        InputTransparent="True"
                        Margin="5"
                        BackgroundColor="{StaticResource MoleBrown}"
                        Stroke="{StaticResource MoleOutline}"
                        StrokeThickness="3"
                        StrokeShape="RoundRectangle 50"
                        Padding="10">
                    <Label Text="🐹" FontSize="40"
                            HorizontalOptions="Center" VerticalOptions="Center"/>
                </Border>
            </Grid>

            <Button x:Name="StartButton"
                    Text="Start Game"
                    Style="{StaticResource GameButton}"
                    Clicked="StartGameButton"/>

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
